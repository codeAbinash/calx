// Variables and data types
let integer: int = 42;
let float: float = 3.14159;
let text: str = "Hello world";
let single_quote: str = 'Calx';
let is_active: bool = true;
let is_empty: bool = false;

// Modulo
let remainder = 10 % 3;

// Dot access
let length = text.length;

// Return from a function
fn double(x) {
    return x * 2;
}
