// Arithmetic
let sum = 10 + 20;
let diff = 50 - 15;
let product = 6 * 7;
let quotient = 100 / 4;

// Comparisons
let eq = (10 == 10);
let ne = (10 != 20);
let lt = (5 < 10);
let gt = (20 >= 10);

// Logical
let both = true && false;
let either = true || false;
let invert = !true;

// Bitwise
let bit_and = 5 & 3;
let bit_or = 5 | 2;
let bit_xor = 5 ^ 1;
