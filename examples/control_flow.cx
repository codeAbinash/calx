// If / Else conditions
let score = 85;

if (score >= 90) {
    print("Grade: A");
} else if (score >= 80) {
    print("Grade: B");
} else {
    print("Grade: C");
}

// While loop
let count = 0;
while (count < 5) {
    count = count + 1;
}

// For loop
for (item in [1, 2, 3, 4]) {
    print(item);
}
